# ============ Database Configuration ============
# PostgreSQL connection for persistent state storage
DATABASE_URL=postgresql+psycopg2://gemsentinel:gemsentinel@localhost:5432/gemsentinel
TEST_DATABASE_URL=postgresql+psycopg2://gemsentinel:gemsentinel@localhost:5432/gemsentinel_test

# ============ JWT Configuration ============
# JWT secret key for token signing/validation (CHANGE in production!)
JWT_SECRET_KEY=dev-secret-change-in-production-12345
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

# ============ Environment & Logging ============
ENVIRONMENT=development
LOG_LEVEL=INFO

# Private document storage (application-relative paths are persisted in the database)
UPLOAD_ROOT=

# Verification providers: MOCK uses clearly labelled fixture data.
# LIVE and SANDBOX remain UNAVAILABLE until matching providers and credentials exist.
VERIFICATION_ADAPTER_MODE=MOCK

# ============ Government APIs ============
# data.gov.in Open Government Data API Configuration
DATA_GOV_IN_API_KEY=your_data_gov_in_api_key_here

# Resource ID for Company Master Data (MCA / RoC) from data.gov.in/catalog/company-master-data
DATA_GOV_IN_COMPANY_MASTER_RESOURCE_ID=your_roc_company_master_resource_id_here
